{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"__SKILL_DIR__/hooks/caveman-sessionstart.mjs\"",
            "statusMessage": "Loading caveman mode",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ]
  }
}
