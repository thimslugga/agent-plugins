#!/usr/bin/env python3
"""Validate a git commit message against Conventional Commits 1.0.0.

Usage:
    check-commit-msg <message-file>        # also works as a commit-msg hook
    check-commit-msg --message "..."       # validate a literal message
    git log -1 --format=%B | check-commit-msg

Exit 0 when the message is spec-compliant, 1 otherwise. Warnings (unknown
type, long subject) go to stderr but do not fail; only spec violations fail.

Install as a hook to enforce the format:
    cp scripts/check-commit-msg .git/hooks/commit-msg
"""

from __future__ import annotations

import argparse
import re
import sys

VERSION = "1.0.0"

# Angular/commitlint recommended types; anything else that is a valid noun
# still passes, with a warning.
KNOWN_TYPES = frozenset(
    {
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert",
    }
)

SUBJECT_RE = re.compile(
    r"^(?P<type>[A-Za-z]+)(?P<scope>\([^()\s]+\))?(?P<breaking>!)?: (?P<desc>.+)$"
)
FOOTER_TOKEN_RE = re.compile(r"^(?P<token>[A-Za-z-]+|BREAKING CHANGE)(?P<sep>: | #)")


def _warn(msg: str) -> None:
    print(f"warning: {msg}", file=sys.stderr)


def validate(message: str) -> list[str]:
    """Return a list of spec violations; empty means the message is valid."""
    errors: list[str] = []
    lines = message.rstrip("\n").split("\n")
    if not lines or not lines[0].strip():
        return ["empty commit message"]

    subject = lines[0]
    match = SUBJECT_RE.match(subject)
    if not match:
        return [
            "subject must match '<type>[scope][!]: <description>', e.g. "
            "'feat(parser): add ability to parse arrays'"
        ]

    commit_type = match.group("type")
    desc = match.group("desc")
    if not desc.strip():
        errors.append("description must not be empty")
    if desc != desc.strip():
        errors.append("description must not have leading/trailing whitespace")
    if desc.rstrip().endswith("."):
        errors.append("description must not end with a period")
    if desc and desc[0].isupper():
        _warn("description should start lowercase, e.g. 'fix: correct typo'")
    if len(subject) > 72:
        _warn(f"subject is {len(subject)} chars; keep it under 72")
    if commit_type.lower() not in KNOWN_TYPES:
        _warn(
            f"unknown type '{commit_type}'; recommended types: "
            + ", ".join(sorted(KNOWN_TYPES))
        )

    # Body must begin one blank line after the description.
    if len(lines) > 1 and lines[1].strip():
        errors.append("body must begin one blank line after the description")

    # Footers, if present, follow one blank line after the body.
    in_footer = False
    for i, line in enumerate(lines[1:], start=1):
        if not line.strip():
            in_footer = False
            continue
        if FOOTER_TOKEN_RE.match(line):
            in_footer = True
            continue
        if in_footer:
            # Continuation of a multi-line footer value is allowed.
            continue
        if i > 1 and not lines[i - 1].strip():
            # First non-blank line after a blank line that is not a valid
            # footer token is the start of the body; that's fine.
            continue

    # A lowercase 'breaking change' footer token is a spec violation.
    for line in lines:
        if re.match(r"^breaking change:", line, re.IGNORECASE) and not line.startswith(
            "BREAKING CHANGE:"
        ):
            errors.append("the breaking-change footer token MUST be uppercase")
            break

    return errors


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Validate a commit message against Conventional Commits 1.0.0."
    )
    parser.add_argument("file", nargs="?", help="file containing the commit message")
    parser.add_argument("-m", "--message", help="validate a literal message string")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    args = parser.parse_args(argv)

    if args.message is not None:
        message = args.message
    elif args.file:
        try:
            with open(args.file, encoding="utf-8") as fh:
                message = fh.read()
        except OSError as exc:
            print(f"error: cannot read {args.file}: {exc}", file=sys.stderr)
            return 2
    elif not sys.stdin.isatty():
        message = sys.stdin.read()
    else:
        parser.error("provide a message file, --message, or pipe the message on stdin")

    # Strip git's comment lines (commit-msg hook files contain them).
    message = "\n".join(
        line for line in message.split("\n") if not line.startswith("#")
    )

    errors = validate(message)
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        print(f"\n{len(errors)} spec violation(s) found.", file=sys.stderr)
        return 1
    print("commit message is valid")
    return 0


if __name__ == "__main__":
    sys.exit(main())
