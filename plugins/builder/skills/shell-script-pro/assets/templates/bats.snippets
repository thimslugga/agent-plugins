# UltiSnips snippets for BATS test files.
#
# Install: save this file as ~/.vim/UltiSnips/bats.snippets
# (or the equivalent snippets directory for your snippet engine).
#
# BATS files use the .bats extension, which Vim does not recognize by
# default. Detect them via extension match — add to
# ~/.vim/ftdetect/bats.vim (or init.vim):
#
#   autocmd BufNewFile,BufRead *.bats set filetype=bats
#
# With filetype=bats set, shfmt can format them via -ln=bats.

snippet bats
	#!/usr/bin/env bats

snippet @test
	@test "${1:test something}" {
	  $0
	}

snippet line
	[ "${lines[${1:0}]}" = "${2:some value}" ]

snippet output
	[ "$output" = "${1:foo: no such file 'nonexistent_filename'}" ]

snippet status
	[ "$status" -eq ${1:0} ]

snippet run
	run foo
	[ "$status" -eq ${1:0} ]
